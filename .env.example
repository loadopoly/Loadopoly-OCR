# Supabase Configuration
# Get your credentials from: https://supabase.com/dashboard → Project Settings → API
# Bakugo (card centering) uses this same project via bakugo_scans / bakugo_labels.
# Desktop/CLI aliases: CARDCENTER_SUPABASE_URL + CARDCENTER_SUPABASE_ANON_KEY.
# Never put a service-role key in these variables or in Pages config.json.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Vision / OCR: Supply-Chain-Architect OCR endpoint (cheap: free-tier ensemble + recall cache)
# Tried before Gemini. Unset = Gemini-only (no cheap middle tier).
# Example: https://scb.example.com/ocr (or leave unset for local/test).
VITE_SCB_OCR_URL=

# Legacy: VITE_GEMINI_API_KEY deprecated; leave unset on new installs.

# Web3 Configuration (Optional)
# The address of the DCC1 Shard Contract on Polygon
VITE_DCC1_ADDRESS=0x71C7656EC7ab88b098defB751B7401B5f6d89A21